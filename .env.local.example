# ─── Database (Neon Postgres — the project's actual store) ───
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/sportx?sslmode=require"

# ─── NextAuth ───
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Public origin used in invite emails sent from /api/academy/players/:id/invite
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Supabase keys (kept for parity with template prompts) ───
# The academy onboarding flow uses Neon directly, but these placeholders
# stay here so anyone wiring up the Supabase-backed version can drop
# values in without renaming variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
