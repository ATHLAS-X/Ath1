# ─── Database (Neon Postgres — the project's actual store) ───
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/sportx?sslmode=require"

# ─── NextAuth ───
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Public origin used in invite emails sent from /api/academy/players/:id/invite
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Supabase (REMOVED — Section 69A ISP block, Feb 2026) ───
# Supabase has been removed from the architecture. The platform uses Neon
# Postgres directly. Do not re-enable. See architecture doc v2.0 Section 3.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ─── Compute Service (Backend/AI FastAPI service) ───
# URL where the Backend/AI compute service is running.
COMPUTE_SERVICE_URL=http://localhost:8000
# Shared secret for JWT auth bridge. Must EXACTLY match AUTH_JWT_SECRET in
# Backend/AI/.env. Generate with: openssl rand -hex 32. Never use dev value in prod.
COMPUTE_AUTH_SECRET=

# ─── Gemini API ───
# GEMINI_API_KEY is NOT used by Next.js directly. All Gemini calls go through
# the compute service. Add your API key to Backend/AI/.env instead.
# GEMINI_API_KEY=
