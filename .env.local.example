# ─── Database (Supabase Postgres — the project's actual store; confirmed
# live host db.haexxhxjcwjpnnyoxcnq.supabase.co, see
# docs/AthlasX_DB2_Pending_Migrations_Apply_Fix.md) ───
DATABASE_URL="postgresql://user:password@db.xxx.supabase.co:5432/postgres?sslmode=require"
# Direct (non-pooled) connection — required by prisma/schema.prisma's
# datasource block (directUrl), used for migrations/introspection.
DATABASE_DIRECT_URL="postgresql://user:password@db.xxx.supabase.co:5432/postgres?sslmode=require"

# ─── NextAuth ───
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ─── Sentry (error monitoring) ───
# All optional — the SDK no-ops safely with no DSN set (src/app/error.tsx
# still shows the fallback screen, it just doesn't report anywhere).
# NEXT_PUBLIC_ prefix: the client-side init (instrumentation-client.ts)
# needs this value inlined into the browser bundle at build time.
NEXT_PUBLIC_SENTRY_DSN=""
# Server-side only (falls back to NEXT_PUBLIC_SENTRY_DSN above if unset —
# only set this separately if you want server events on a different
# Sentry project than client events).
SENTRY_DSN=""
# Needed only to enable source-map upload at build time (next.config.mjs).
# Without these, the build still succeeds — Sentry's webpack plugin just
# skips that step and logs a warning.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
