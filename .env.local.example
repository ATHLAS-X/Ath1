# ─── Database (Neon Postgres) ─────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/athlasx?sslmode=require"
# Direct (non-pooled) — used ONLY by prisma migrate deploy
DATABASE_DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/athlasx?sslmode=require"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Public origin used in invite emails from /api/academy/players/:id/invite
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── AI (Gemini) ──────────────────────────────────────────────────────────────
# Get from Google AI Studio → https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# ─── Redis (local dev: run redis-server or docker run redis) ──────────────────
REDIS_URL="redis://localhost:6379"

# ─── OCI Object Storage ───────────────────────────────────────────────────────
OCI_ACCESS_KEY=""
OCI_SECRET_KEY=""
OCI_BUCKET_REGION="ap-hyderabad-1"
OCI_BUCKET_NAME="athlasx-media"
OCI_S3_ENDPOINT=""

# ─── SMS (MSG91) ──────────────────────────────────────────────────────────────
SMS_GATEWAY_API_KEY=""

# ─── KYC (Surepass / Signzy — requires registered entity) ────────────────────
KYC_PROVIDER_API_KEY=""
