# ─── Database (Neon Postgres — the project's actual store) ───
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/sportx?sslmode=require"

# ─── NextAuth ───
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Keyed HMAC used to tokenize Aadhaar numbers for duplicate-account detection
# (lib/aadhaar.ts) — without this, the onboarding Aadhaar-confirm step throws.
AADHAAR_HMAC_SECRET="replace-with-openssl-rand-base64-32"

# Public origin used in invite emails sent from /api/academy/players/:id/invite
NEXT_PUBLIC_APP_URL="http://localhost:3000"
