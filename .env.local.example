# ─── Database (Neon Postgres) ─────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/athlasx?sslmode=require"
# Direct (non-pooled) — used ONLY by prisma migrate deploy
DATABASE_DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/athlasx?sslmode=require"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Public origin used in invite emails from /api/academy/players/:id/invite
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── AI (Gemini) ──────────────────────────────────────────────────────────────
# Get from Google AI Studio → https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# ─── Redis (local dev: run redis-server or docker run redis) ──────────────────
REDIS_URL="redis://localhost:6379"

# ─── OCI Object Storage ───────────────────────────────────────────────────────
OCI_ACCESS_KEY=""
OCI_SECRET_KEY=""
OCI_BUCKET_REGION="ap-hyderabad-1"
OCI_BUCKET_NAME="athlasx-media"
OCI_S3_ENDPOINT=""

# ─── SMS (MSG91) ──────────────────────────────────────────────────────────────
SMS_GATEWAY_API_KEY=""

# ─── KYC (Surepass / Signzy — requires registered entity) ────────────────────
KYC_PROVIDER_API_KEY=""

# ─── Compute Service (Mrigank's FastAPI) ──────────────────────────────────────
# Shared secret for HS256 JWT auth — must match COMPUTE_AUTH_SECRET on the compute service
COMPUTE_AUTH_SECRET="replace-with-openssl-rand-base64-32"
# Base URL of the deployed compute service (no trailing slash)
COMPUTE_SERVICE_URL="http://localhost:8000"

# ─── Email (Resend) ────────────────────────────────────────────────────────────
# Get from resend.com → API Keys. Verify your sending domain (athlasx.in) in Resend dashboard.
# Without this key, emails fall back to console.log (dev only).
RESEND_API_KEY=""
# Sender address — must match a verified domain in your Resend account
EMAIL_FROM="AthlasX <noreply@athlasx.in>"
