# ── Database ──────────────────────────────────────────────────────────────────
# Neon pooled connection (used at runtime by Next.js + FastAPI via SQLAlchemy)
NEON_POOLED_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/athlasx?sslmode=require
DATABASE_URL=${NEON_POOLED_URL}
# Direct (non-pooled) connection — used ONLY by prisma migrate
DATABASE_DIRECT_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/athlasx?sslmode=require

# ── Auth ──────────────────────────────────────────────────────────────────────
AUTH_SECRET=                          # openssl rand -base64 32
NEXTAUTH_URL=https://athlasx.in
NEXTAUTH_SECRET=${AUTH_SECRET}

# ── AI ────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=                       # Google AI Studio → API Keys

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── OCI Object Storage ────────────────────────────────────────────────────────
OCI_ACCESS_KEY=
OCI_SECRET_KEY=
