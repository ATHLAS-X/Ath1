OCI_BUCKET_NAME=athlasx-media
OCI_S3_ENDPOINT=https://<namespace>.compat.objectstorage.ap-hyderabad-1.oraclecloud.com

# ── KYC / Aadhaar ─────────────────────────────────────────────────────────────
