# ATHLASX Compute Service — environment variables
# Copy to .env and fill in. NEVER commit a real .env (see .gitignore conventions
# in the repo root). All names follow the project's existing infra/.env.template.

# ─── Runtime ──────────────────────────────────────────────────────────────────
# development | staging | production
# The dev-only JWT minting helper REFUSES to run unless this is "development".
ENVIRONMENT=development

# ─── Database ─────────────────────────────────────────────────────────────────
# Standalone build points at the LOCAL isolated Postgres from docker-compose.dev.yml.
# Must be an async driver URL (postgresql+asyncpg://...).
# At real integration time this becomes the Neon POOLED url (see RECONCILIATION_NOTES.md).
DATABASE_URL=postgresql+asyncpg://athlasx:athlasx@localhost:5433/athlasx_compute

# ─── Redis (ARQ queue + rate-limit counters + video cache) ───────────────────
# ARQ uses logical DB 1 by convention (DB 0 = BullMQ, DB 2 = OTP) per arch doc 11.1.
REDIS_URL=redis://localhost:6380/1

# ─── AI (Google Gemini) ───────────────────────────────────────────────────────
# Get from Google AI Studio → https://aistudio.google.com/app/apikey
GEMINI_API_KEY= 

# Configurable model strings (do NOT hardcode in code). Verified 2026-06 against
# https://ai.google.dev/gemini-api/docs/models — re-verify before production.
#   VIDEO: PREVIEW model — restrictive rate limits, can be deprecated on ~2 weeks' notice.
GEMINI_VIDEO_MODEL=gemini-3.1-pro-preview
#   TEXT (psychology): current stable flagship Flash.
GEMINI_TEXT_MODEL=gemini-3.5-flash
#   OCR: separate var for future flexibility; defaults to the text model.
GEMINI_OCR_MODEL=gemini-3.5-flash

# ─── Auth (standalone HS256 — swap for Auth.js at integration) ───────────────
# Shared secret used to verify Bearer JWTs (role + user_id claims).
AUTH_JWT_SECRET=dev-only-insecure-secret-change-me

# ─── Observability (optional) ─────────────────────────────────────────────────
# If empty, Sentry is not initialised. Use a SEPARATE Sentry project from web.
SENTRY_DSN=

# ─── CORS (browser frontend access) ───────────────────────────────────────────
# Comma-separated allowed origins. "*" is fine for local dev; set explicit origins
# in production, e.g. "http://localhost:3000,https://app.athlasx.in"
CORS_ALLOW_ORIGINS=*
