# ATHLASX Compute — ARQ worker image (production-shaped).
#
# ARM64 NOTE: same as the API image — python:3.12-slim has a linux/arm64 variant and
# all deps ship aarch64 wheels, so this builds natively on Oracle Ampere A1 (ARM64).
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements.txt .
RUN pip install -r requirements.txt

COPY app/ ./app/

RUN useradd -m appuser && chown -R appuser /app
USER appuser

CMD ["python", "-m", "arq", "app.worker.WorkerSettings"]
