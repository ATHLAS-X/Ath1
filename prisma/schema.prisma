// AthlasX V1 Data Model — Prisma schema
// Generated from "MVP flows and data model.docx"
//
// Conventions:
//   • Model names: PascalCase. Table names: snake_case via @@map.
//   • Field names: snake_case (matches the existing raw-SQL schema style).
//   • UUIDs everywhere — gen_random_uuid() via @default(dbgenerated).
//   • Soft enums (status, type) live as Prisma enums for type safety.
//
// NOTE: This is an additive design. The existing Neon DB already has 14
// tables from lib/schema.sql. Migrations should be authored carefully —
// see prisma/MIGRATION_NOTES.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────

enum UserRole {
  PLAYER
  PARENT
  ACADEMY_ADMIN
  COACH
  SCOUT
  TOURNAMENT_ORGANIZER
  ATHLASX_ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum SourceChannel {
  INDEPENDENT_PLAYER
  ACADEMY
  TOURNAMENT
  SCOUT
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum DominantHand {
  RIGHT
  LEFT
  AMBIDEXTROUS
}

enum PrimaryRole {
  BATTER
  BOWLER
  ALL_ROUNDER
  WICKETKEEPER
}

enum BattingStyle {
  RIGHT_HAND
  LEFT_HAND
}

enum BowlingStyle {
  FAST
  MEDIUM_FAST
  MEDIUM
  OFF_SPIN
  LEG_SPIN
  LEFT_ARM_SPIN
  LEFT_ARM_FAST
  LEFT_ARM_ORTHODOX
  CHINAMAN
}

enum VisibilityState {
  HIDDEN
  DRAFT
  LIVE
}

enum VerificationLevel {
  SELF_REGISTERED
  IDENTITY_VERIFIED
  PERFORMANCE_VERIFIED
  SCOUT_VERIFIED
}

enum VerificationType {
  SELF
  IDENTITY
  PERFORMANCE
  SCOUT
}

enum VerificationStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

enum MediaType {
  VIDEO
  PHOTO
  SCORECARD
  CERTIFICATE
  AUDIO
}

enum CoachStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum CoachingRole {
  HEAD
  ASSISTANT
  SPECIALIST
  FREELANCE
}

enum CertStatus {
  PENDING
  VERIFIED
  NONE
}

enum JoinStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GRANDPARENT
  LEGAL_GUARDIAN
  SIBLING
  OTHER
}

enum ScoutType {
  INDEPENDENT
  FRANCHISE
  STATE
  COUNTRY
  ACADEMY_AFFILIATE
}

// ─── 1. USER ACCOUNT ──────────────────────────────────────────────────────

model User {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String         @unique
  password_hash     String?
  phone             String?        @unique
  email_verified_at DateTime?      @db.Timestamptz(6)
  phone_verified_at DateTime?      @db.Timestamptz(6)
  role              UserRole?      @default(PLAYER)
  account_status    AccountStatus  @default(PENDING)
  source_channel    SourceChannel  @default(INDEPENDENT_PLAYER)
  display_name      String?
  oauth_provider    String?
  oauth_id          String?
  created_at        DateTime       @default(now()) @db.Timestamptz(6)
  updated_at        DateTime       @updatedAt @db.Timestamptz(6)

  // Relations — at most one of these per user
  player_profile    PlayerProfile?
  academy_profile   AcademyProfile?
  scout_profile     ScoutProfile?

  // Inverse relations (audit trails of contributions this user authored)
  fitness_recorded  FitnessAssessment[]    @relation("FitnessRecordedBy")
  evaluations_given BehavioralEvaluation[] @relation("EvaluatedBy")
  milestones_added  DevelopmentMilestone[] @relation("MilestoneAddedBy")
  verifications_signed Verification[]      @relation("VerifiedBy")
  academy_coach_seat   AcademyCoach?

  @@index([role])
  @@index([account_status])
  // Prisma's DSL can't express a partial index (WHERE x IS NOT NULL); the
  // actual constraint — unique only when both columns are non-null — lives
  // in lib/schema.sql's users_oauth_uidx. This is the closest declarative
  // equivalent for schema-diffing purposes (per MIGRATION_NOTES.md, this
  // schema isn't applied to the live DB anyway).
  @@unique([oauth_provider, oauth_id])
  @@map("users")
}

// ─── PHONE OTP ────────────────────────────────────────────────────────────
// Short-lived 6-digit codes for phone verification.

model PhoneOtp {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?   @db.Uuid
  phone       String
  code_hash   String
  attempts    Int       @default(0)
  expires_at  DateTime  @db.Timestamptz(6)
  consumed_at DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)

  @@index([user_id, phone])
  @@index([expires_at])
  @@map("phone_otps")
}

// ─── AADHAAR OTP ────────────────────────────────────────────────────────────
// Short-lived 6-digit codes for the Aadhaar verify step.

model AadhaarOtp {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String?   @db.Uuid
  aadhaar_last4 String
  code_hash     String
  attempts      Int       @default(0)
  expires_at    DateTime  @db.Timestamptz(6)
  consumed_at   DateTime? @db.Timestamptz(6)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)

  @@index([user_id])
  @@index([expires_at])
  @@map("aadhaar_otps")
}

// ─── 2. PLAYER PROFILE ────────────────────────────────────────────────────
// 1:1 with User (optional — not every user is a player)

model PlayerProfile {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String           @unique @db.Uuid
  user                User             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // Identity
  first_name          String
  last_name           String
  date_of_birth       DateTime         @db.Date
  gender              Gender
  // Location
  city                String?
  district            String?
  state               String?
  country             String           @default("India")
  // Physical
  height_cm           Decimal?         @db.Decimal(5, 2)
  weight_kg           Decimal?         @db.Decimal(5, 2)
  dominant_hand       DominantHand?
  // Cricket
  primary_role        PrimaryRole?
  secondary_role      PrimaryRole?
  batting_style       BattingStyle?
  bowling_style       BowlingStyle?
  wicket_keeper       Boolean          @default(false)
  // Teams (free text per the doc — no rigid org model in V1)
  school_team         String?
  club_team           String?
  district_team       String?
  state_team          String?
  // Academy link (optional — independent players have none)
  academy_id          String?          @db.Uuid
  academy             AcademyProfile?  @relation(fields: [academy_id], references: [id], onDelete: SetNull)
  // Bio
  player_bio          String?          @db.Text
  aspirations         String?          @db.Text
  strengths           String?          @db.Text
  improvement_areas   String?          @db.Text
  // Cached latest assessment snapshots (denormalised for fast list views)
  latest_yoyo_score   Decimal?         @db.Decimal(5, 2)
  latest_30m_sprint   Decimal?         @db.Decimal(4, 2)
  latest_2km_run      Decimal?         @db.Decimal(6, 2)
  avg_discipline_score      Decimal?   @db.Decimal(4, 2)
  avg_coachability_score    Decimal?   @db.Decimal(4, 2)
  avg_work_ethic_score      Decimal?   @db.Decimal(4, 2)
  avg_leadership_score      Decimal?   @db.Decimal(4, 2)
  avg_mental_toughness      Decimal?   @db.Decimal(4, 2)
  // Discovery state
  visibility          VisibilityState  @default(DRAFT)
  verification_level  VerificationLevel @default(SELF_REGISTERED)
  profile_completion_pct Int           @default(0)
  // Timestamps
  created_at          DateTime         @default(now()) @db.Timestamptz(6)
  updated_at          DateTime         @updatedAt @db.Timestamptz(6)

  // Relations
  consents              PlayerConsent[]
  guardian_consents     GuardianConsent[]
  media                 PlayerMedia[]
  performance_summaries PlayerPerformanceSummary[]
  fitness_assessments   FitnessAssessment[]
  behavioral_evaluations BehavioralEvaluation[]
  development_milestones DevelopmentMilestone[]
  verifications         Verification[]
  watchlisted_by        ScoutWatchlist[]
  scout_notes           ScoutNote[]

  @@index([visibility])
  @@index([academy_id])
  @@index([state, city])
  @@index([primary_role])
  @@map("player_profiles")
}

// ─── 3. PLAYER CONSENT ────────────────────────────────────────────────────
// One row per consent event (parental, privacy, media release). 1:many.

model PlayerConsent {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  player_id              String        @db.Uuid
  player                 PlayerProfile @relation(fields: [player_id], references: [id], onDelete: Cascade)

  consent_type           String        // e.g. PARENTAL, MEDIA_RELEASE, DATA_SHARING
  parent_name            String?
  parent_phone           String?
  parent_phone_verified  Boolean       @default(false)
  parent_email           String?
  parent_email_verified  Boolean       @default(false)
  disclaimer_signed      Boolean       @default(false)
  minor_flag             Boolean       @default(false)
  signed_at              DateTime?     @db.Timestamptz(6)
  evidence_url           String?       // signed PDF / OTP receipt
  created_at             DateTime      @default(now()) @db.Timestamptz(6)

  @@index([player_id])
  @@map("player_consents")
}

// ─── GUARDIAN CONSENT ─────────────────────────────────────────────────────
// One row per minor player — created when guardian OTP is verified during
// Step 1 of the Player onboarding wizard.

model GuardianConsent {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  player_id            String                @db.Uuid
  player               PlayerProfile         @relation(fields: [player_id], references: [id], onDelete: Cascade)

  guardian_name        String
  relationship         GuardianRelationship
  guardian_phone       String
  phone_verified       Boolean               @default(true)
  consent_given        Boolean               @default(true)
  created_at           DateTime              @default(now()) @db.Timestamptz(6)

  @@index([player_id])
  @@map("guardian_consents")
}

// ─── 4. PLAYER MEDIA ──────────────────────────────────────────────────────

model PlayerMedia {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  player_id       String        @db.Uuid
  player          PlayerProfile @relation(fields: [player_id], references: [id], onDelete: Cascade)

  media_type      MediaType
  url             String
  youtube_video_id String?
  title           String?
  description     String?       @db.Text
  uploaded_by_user_id String?   @db.Uuid       // who uploaded it (player/academy/admin)
  ai_analysed     Boolean       @default(false)
  strong_points   String[]
  weak_points     String[]
  uploaded_at     DateTime      @default(now()) @db.Timestamptz(6)

  @@index([player_id, media_type])
  @@map("player_media")
}

// ─── 5. PLAYER PERFORMANCE SUMMARY ────────────────────────────────────────
// One row per (player, format) — career aggregates across all matches.

model PlayerPerformanceSummary {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  player_id       String        @db.Uuid
  player          PlayerProfile @relation(fields: [player_id], references: [id], onDelete: Cascade)
  format          String        // T20, ODI, LIST_A, FIRST_CLASS

  // Batting
  matches_batted  Int           @default(0)
  innings         Int           @default(0)
  runs            Int           @default(0)
  not_outs        Int           @default(0)
  highest_score   String?       // e.g. "78*"
  batting_avg     Decimal?      @db.Decimal(6, 2)
  strike_rate     Decimal?      @db.Decimal(6, 2)
  fifties         Int           @default(0)
  hundreds        Int           @default(0)
  // Bowling
  matches_bowled  Int           @default(0)
  overs_bowled    Decimal?      @db.Decimal(7, 1)
  wickets         Int           @default(0)
  bowling_avg     Decimal?      @db.Decimal(6, 2)
  economy         Decimal?      @db.Decimal(5, 2)
  bowling_sr      Decimal?      @db.Decimal(6, 2)
  best_figures    String?       // e.g. "5/22"
  five_fors       Int           @default(0)
  // Fielding
  catches         Int           @default(0)
  stumpings       Int           @default(0)
  runouts         Int           @default(0)

  updated_at      DateTime      @updatedAt @db.Timestamptz(6)

  @@unique([player_id, format])
  @@index([player_id])
  @@map("player_performance_summaries")
}

// ─── 6. ACADEMY PROFILE ───────────────────────────────────────────────────

model AcademyProfile {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id              String           @unique @db.Uuid
  user                 User             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  academy_name         String
  city                 String?
  state                String?
  country              String           @default("India")
  established_year     Int?
  head_coach_name      String?
  registration_number  String?
  affiliations         String[]         // e.g. ["BCCI L2", "State CA"]
  logo_url             String?
  bio                  String?          @db.Text
  visibility           VisibilityState  @default(DRAFT)
  verification_status  VerificationStatus @default(PENDING)
  created_at           DateTime         @default(now()) @db.Timestamptz(6)
  updated_at           DateTime         @updatedAt @db.Timestamptz(6)

  // Relations
  coaches              AcademyCoach[]
  players              PlayerProfile[]

  @@index([state, city])
  @@index([verification_status])
  @@map("academy_profiles")
}

// ─── 7. ACADEMY COACHES ──────────────────────────────────────────────────
// A coach inside an academy. May or may not have a user login.

model AcademyCoach {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academy_id        String         @db.Uuid
  academy           AcademyProfile @relation(fields: [academy_id], references: [id], onDelete: Cascade)
  user_id           String?        @unique @db.Uuid       // optional login seat
  user              User?          @relation(fields: [user_id], references: [id], onDelete: SetNull)

  coach_name        String
  role              String?        // Head Coach, Batting Coach, etc.
  certificate_type  String?        // BCCI L1, BCCI L2, NIS, NCA
  certificate_url   String?
  bio               String?        @db.Text
  status            CoachStatus    @default(PENDING_REVIEW)
  approved_at       DateTime?      @db.Timestamptz(6)
  created_at        DateTime       @default(now()) @db.Timestamptz(6)

  @@index([academy_id])
  @@map("academy_coaches")
}

// ─── 7b. COACH PROFILE ────────────────────────────────────────────────────
// Standalone coach row — separate from AcademyCoach (which is a seat inside
// an academy). A COACH-role user has one of these after onboarding.

model CoachProfile {
  id                        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                   String         @unique @db.Uuid
  // Step 1
  first_name                String?
  last_name                 String?
  email                     String?
  // Step 2
  coaching_role             CoachingRole?
  specialisations           String[]
  age_groups_coached        String[]
  coaching_experience_years Int?
  city                      String?
  state                     String?
  played_state_level        Boolean?
  highest_level_played      String?
  playing_role              String?
  // Step 3
  highest_certification     String?
  certificate_url           String?
  certification_status      CertStatus?    @default(NONE)
  // Onboarding state
  onboarding_step           Int            @default(1)
  onboarding_complete       Boolean        @default(false)
  created_at                DateTime       @default(now()) @db.Timestamptz(6)
  updated_at                DateTime       @updatedAt @db.Timestamptz(6)

  academy_links             CoachAcademy[]

  @@map("coach_profiles")
}

// ─── 7c. COACH ↔ ACADEMY LINK ────────────────────────────────────────────

model CoachAcademy {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  coach_id    String       @db.Uuid
  academy_id  String       @db.Uuid
  status      JoinStatus   @default(PENDING)
  invite_code String?
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  coach       CoachProfile @relation(fields: [coach_id], references: [id], onDelete: Cascade)

  @@unique([coach_id, academy_id])
  @@map("coach_academy")
}

// ─── 7d. ACADEMY INVITE CODES ─────────────────────────────────────────────

model AcademyInviteCode {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academy_id  String   @db.Uuid
  code        String   @unique
  used_by     String?  @db.Uuid
  expires_at  DateTime @db.Timestamptz(6)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@map("academy_invite_codes")
}

// ─── 8. SCOUT PROFILE ─────────────────────────────────────────────────────

model ScoutProfile {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String           @unique @db.Uuid
  user                User             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  scout_name          String
  organization        String?
  scout_type          ScoutType        @default(INDEPENDENT)
  city                String?
  state               String?
  country             String           @default("India")
  bio                 String?          @db.Text
  // Saved preferences for default search
  pref_min_age        Int?
  pref_max_age        Int?
  pref_roles          PrimaryRole[]    @default([])
  pref_states         String[]         @default([])
  verification_status VerificationStatus @default(PENDING)
  subscription_status String           @default("inactive")
  subscription_renews_at DateTime?     @db.Timestamptz(6)
  created_at          DateTime         @default(now()) @db.Timestamptz(6)
  updated_at          DateTime         @updatedAt @db.Timestamptz(6)

  // Relations
  watchlist           ScoutWatchlist[]
  notes               ScoutNote[]

  @@index([verification_status])
  @@index([state])
  @@map("scout_profiles")
}

// ─── 9. SCOUT WATCHLIST ──────────────────────────────────────────────────
// Private to the scout. One row per (scout, player).

model ScoutWatchlist {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scout_id        String        @db.Uuid
  scout           ScoutProfile  @relation(fields: [scout_id], references: [id], onDelete: Cascade)
  player_id       String        @db.Uuid
  player          PlayerProfile @relation(fields: [player_id], references: [id], onDelete: Cascade)

  scout_rating    Int?          // 1-10
  potential_tag   String?       // e.g. "U-19 IPL pick", "domestic pace bowler"
  added_at        DateTime      @default(now()) @db.Timestamptz(6)

  @@unique([scout_id, player_id])
  @@index([scout_id])
  @@index([player_id])
  @@map("scout_watchlist")
}

// ─── 10. SCOUT NOTES ─────────────────────────────────────────────────────
// Many notes per scout per player. Always private.

model ScoutNote {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scout_id        String        @db.Uuid
  scout           ScoutProfile  @relation(fields: [scout_id], references: [id], onDelete: Cascade)
  player_id       String        @db.Uuid
  player          PlayerProfile @relation(fields: [player_id], references: [id], onDelete: Cascade)

  note            String        @db.Text
  is_pinned       Boolean       @default(false)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @updatedAt @db.Timestamptz(6)

  @@index([scout_id, player_id])
  @@map("scout_notes")
}

// ─── 11. VERIFICATION ─────────────────────────────────────────────────────
// The trust layer — each verification claim against a player.

model Verification {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  player_id            String        @db.Uuid
  player               PlayerProfile @relation(fields: [player_id], references: [id], onDelete: Cascade)

  verification_type    VerificationType
  status               VerificationStatus @default(PENDING)
  evidence_url         String?
  evidence_metadata    Json?
  verified_by_user_id  String?       @db.Uuid           // who approved/rejected
  verified_by          User?         @relation("VerifiedBy", fields: [verified_by_user_id], references: [id], onDelete: SetNull)
  verified_at          DateTime?     @db.Timestamptz(6)
  rejection_reason     String?
  created_at           DateTime      @default(now()) @db.Timestamptz(6)

  @@index([player_id, verification_type])
  @@index([status])
  @@map("verifications")
}

// ─── 12. FITNESS ASSESSMENT ──────────────────────────────────────────────

model FitnessAssessment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  player_id         String        @db.Uuid
  player            PlayerProfile @relation(fields: [player_id], references: [id], onDelete: Cascade)
  recorded_by_user_id String?     @db.Uuid                   // self or academy/admin
  recorded_by       User?         @relation("FitnessRecordedBy", fields: [recorded_by_user_id], references: [id], onDelete: SetNull)

  yoyo_score        Decimal?      @db.Decimal(5, 2)
  sprint_30m_sec    Decimal?      @db.Decimal(4, 2)
  run_2km_sec       Int?                                     // total seconds; format as mm:ss in UI
  vertical_jump_cm  Decimal?      @db.Decimal(5, 2)
  agility_sec       Decimal?      @db.Decimal(4, 2)
  height_cm         Decimal?      @db.Decimal(5, 2)
  weight_kg         Decimal?      @db.Decimal(5, 2)
  resting_hr_bpm    Int?
  fitness_score     Int?                                     // 0-100 composite
  notes             String?       @db.Text
  recorded_at       DateTime      @default(now()) @db.Timestamptz(6)

  @@index([player_id, recorded_at])
  @@map("fitness_assessments")
}

// ─── 13. BEHAVIORAL EVALUATION ───────────────────────────────────────────
// Per the doc: written by coaches inside academies.

model BehavioralEvaluation {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  player_id           String        @db.Uuid
  player              PlayerProfile @relation(fields: [player_id], references: [id], onDelete: Cascade)
  evaluator_user_id   String?       @db.Uuid
  evaluator           User?         @relation("EvaluatedBy", fields: [evaluator_user_id], references: [id], onDelete: SetNull)

  discipline          Int?          // 1-10
  coachability        Int?
  work_ethic          Int?
  leadership          Int?
  mental_toughness    Int?
  communication       Int?
  notes               String?       @db.Text
  coaching_tip        String?       @db.Text
  evaluated_at        DateTime      @default(now()) @db.Timestamptz(6)

  @@index([player_id, evaluated_at])
  @@map("behavioral_evaluations")
}

// ─── 14. DEVELOPMENT MILESTONES ──────────────────────────────────────────
// Growth journal — added by player, academy or admin.

model DevelopmentMilestone {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  player_id           String        @db.Uuid
  player              PlayerProfile @relation(fields: [player_id], references: [id], onDelete: Cascade)
  added_by_user_id    String?       @db.Uuid
  added_by            User?         @relation("MilestoneAddedBy", fields: [added_by_user_id], references: [id], onDelete: SetNull)

  title               String
  description         String?       @db.Text
  milestone_type      String?       // selection, award, debut, trial, score-jump
  evidence_url        String?
  occurred_at         DateTime      @db.Timestamptz(6)
  created_at          DateTime      @default(now()) @db.Timestamptz(6)

  @@index([player_id, occurred_at])
  @@map("development_milestones")
}
